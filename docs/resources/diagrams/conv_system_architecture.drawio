ap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1440" y="800" width="190" height="80" as="geometry"/></mxCell><mxCell id="n84" value="&lt;b&gt;Level 1: add + reg&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;→ 20 bit = ACCUM_WIDTH&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;ellipse;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1680" y="520" width="200" height="90" as="geometry"/></mxCell><mxCell id="n85" value="o_sum [19:0]" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1890" y="545" width="100" height="40" as="geometry"/></mxCell><mxCell id="n86" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n28" target="n82"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n87" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n54" target="n82"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n88" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n80" target="n83"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n89" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n82" target="n84"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n90" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n83" target="n84"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n91" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n84" target="n85"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n92" value="&lt;b&gt;Latency&lt;/b&gt; 2 + N + ⌈log₂N⌉ = 7 at 3×3 (input skew reg, MREG, N PREGs, tree levels). &lt;b&gt;Skew FF&lt;/b&gt; 9·N·N(N+1)/2 (N³ growth).&lt;br&gt;&lt;b&gt;Bit growth&lt;/b&gt;: row sums enter at 16 + ⌈log₂N⌉ bits; each level adds 1 bit, capped at ACCUM_WIDTH; odd counts pass through (sign-extended).&lt;br&gt;7×7: 19 → 20 → 21 → 22 instead of 22 everywhere: −14 LUT, −11 FF, WNS +0.199 → +0.236 ns. Tree is use_dsp = &quot;no&quot; (a DSP costs 50 in the FoM).&lt;br&gt;&lt;b&gt;Used for&lt;/b&gt; 4 ≤ N ≤ 8 with one kernel, and N ≤ 8 with N²·K ≤ 180 for several kernels. 3×3 as a standalone build: 110 LUT / 322 FF (conv_row_chain)." style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="930" width="1400" height="94" as="geometry"/></mxCell><mxCell id="n93" value="&lt;b&gt;Colours&lt;/b&gt;&lt;br&gt;yellow: registers / counters&lt;br&gt;red: window cells · adders&lt;br&gt;blue: DSP48E1 · purple: memory&lt;br&gt;white: logic · dashed box: optional&lt;br&gt;bold red arrow: PCOUT → PCIN · dashed grey: valid / enable" style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1460" y="940" width="300" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page8" name="8 Mul array + adder tree"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="multiplier_array + adder_tree — N² parallel DSP multipliers and a pipelined fabric tree (example N = 3)" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="34" as="geometry"/></mxCell><mxCell id="n3" value="multiplier_array: A/B → M → P registers per DSP (3 cycles). adder_tree: ⌈log₂N²⌉ registered levels, +1 bit per level." style="text;html=1;align=left;verticalAlign=top;fontSize=14;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1600" height="24" as="geometry"/></mxCell><mxCell id="n4" value="pixel 0 (8u) × weight 0 (8s)" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="97" width="270" height="36" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;DSP #0&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;A/B reg → MREG → PREG&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="320" y="90" width="250" height="50" as="geometry"/></mxCell><mxCell id="n6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n7" value="pixel 1 (8u) × weight 1 (8s)" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="192" width="270" height="36" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;DSP #1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;A/B reg → MREG → PREG&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="320" y="1