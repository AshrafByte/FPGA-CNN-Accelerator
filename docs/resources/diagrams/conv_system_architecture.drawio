215" width="220" height="60" as="geometry"/></mxCell><mxCell id="n7" value="K == 1 ?" style="whiteSpace=wrap;html=1;fontSize=13;rhombus;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="200" height="110" as="geometry"/></mxCell><mxCell id="n8" value="N ≤ CHAIN_MAX_N&lt;br&gt;(3) ?" style="whiteSpace=wrap;html=1;fontSize=13;rhombus;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="360" y="350" width="220" height="110" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;MAC_SEL 3 · single chain&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;experiments/conv_single_chain&lt;br&gt;+ max_fanout 24 on pixel WE&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="680" y="365" width="280" height="80" as="geometry"/></mxCell><mxCell id="n10" value="N ≤ ROW_CHAIN_MAX_N&lt;br&gt;(8) ?" style="whiteSpace=wrap;html=1;fontSize=13;rhombus;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="360" y="520" width="220" height="110" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;MAC_SEL 2 · row chains&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;experiments/conv_row_chain&lt;br&gt;(bit-growing row-sum tree)&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="680" y="535" width="280" height="80" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;MAC_SEL 1 · multiplier_array + adder_tree&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;experiments/conv_tree&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="680" y="720" width="280" height="80" as="geometry"/></mxCell><mxCell id="n13" value="2 ≤ N ≤ 8&lt;br&gt;and&lt;br&gt;N²·K ≤ ROW_CHAIN_MAX_DSP&lt;br&gt;(180) ?" style="whiteSpace=wrap;html=1;fontSize=13;rhombus;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="530" width="290" height="180" as="geometry"/></mxCell><mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n15" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n16" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n7" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n20" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n22" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n10" target="n12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="760"/></Array></mxGeometry></mxCell><mxCell id="n23" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n13" target="n11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="615"/><mxPoint x="320" y="660"/><mxPoint x="640" y="660"/><mxPoint x="640" y="575"/></Array></mxGeometry></mxCell><mxCell id="n24" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n13" target="n12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="760"/></Array></mxGeometry></mxCell><mxCell id="n25" value="&lt;b&gt;Result per kernel size N and kernel count K&lt;/b&gt; (DSP count in brackets)&lt;br&gt;&lt;br&gt;&lt;table border=&quot;1&quot; style=&quot;border-collapse:collapse;font-size:12px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#F5F5F5;padding:3px 6px&quot;&gt;&lt;/th&gt;&lt;th style=&quot;background:#F5F5F5;padding:3px 6px&quot;&gt;K = 1&lt;/th&gt;&lt;th style=&quot;background:#F5F5F5;padding:3px 6px&quot;&gt;K = 2&lt;/th&gt;&lt;th style=&quot;background:#F5F5F5;padding:3px 6px&quot;&gt;K = 3&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;&lt;b&gt;N = 1&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;background:#dae8fc;padding:3px 6px&quot;&gt;single&lt;/td&gt;&lt;td style=&quot;background:#f8cecc;padding:3px 6px&quot;&gt;tree&lt;/td&gt;&lt;td style=&quot;background:#f8cecc;padding:3px 6px&quot;&gt;tree&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;&lt;b&gt;N = 2 – 3&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;background:#dae8fc;padding:3px 6px&quot;&gt;single&lt;/td&gt;&lt;td style=&quot;background:#fff2cc;padding:3px 6px&quot;&gt;rows&lt;/td&gt;&lt;td style=&quot;background:#fff2cc;padding:3px 6px&quot;&gt;rows&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;&lt;b&gt;N = 4 – 7&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;background:#fff2cc;padding:3px 6px&quot;&gt;rows&lt;/td&gt;&lt;td style=&quot;background:#fff2cc;padding:3px 6px&quot;&gt;rows&lt;/td&gt;&lt;td style=&quot;background:#fff2cc;padding:3px 6px&quot;&gt;rows&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;&lt;b&gt;N = 8&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;background:#fff2cc;padding:3px 6px&quot;&gt;rows&lt;/td&gt;&lt;td style=&quot;background:#fff2cc;padding:3px 6px&quot;&gt;rows (128)&lt;/td&gt;&lt;td style=&quot;background:#f8cecc;padding:3px 6px&quot;&gt;tree (192)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;&lt;b&gt;N = 9&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;background:#f8cecc;padding:3px 6px&quot;&gt;tree&lt;/td&gt;&lt;td style=&quot;background:#f8cecc;padding:3px 6px&quot;&gt;tree (162)&lt;/td&gt;&lt;td style=&quot;background:#f8cecc;padding:3px 6px&quot;&gt;tree (243)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;&lt;b&gt;N ≥ 10&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;background:#f8cecc;padding:3px 6px&quot;&gt;tree&lt;/td&gt;&lt;td style=&quot;background:#f8cecc;padding:3px 6px&quot;&gt;tree&lt;/td&gt;&lt;td style=&quot;background:#f8cecc;padding:3px 6px&quot;&gt;tree&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;A 1×1 multi-kernel build uses the tree (row chains need N ≥ 2)." style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1020" y="90" width="560" height="300" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;Why these limits&lt;/b&gt; (xc7z020, 250 MHz, measured sweeps)&lt;br&gt;• Single chain: tap e waits e+1 cycles → skew FF = 9·N²(N²+1)/2 per kernel (grows as N⁴).&lt;br&gt;&amp;nbsp;&amp;nbsp;3×3: +243 FF over rows, no power cost → fewest LUTs (70 total).&lt;br&gt;&amp;nbsp;&amp;nbsp;5×5: +2250 FF, ~20 mW more → loses to rows. 9×9: WNS −1.38 ns. 13×13: does not fit (115k FF).&lt;br&gt;&amp;nbsp;&amp;nbsp;The chain must sit in one DSP column (columns of 20/20/60/60/60 slices).&lt;br&gt;• Row chains: skew grows as N³; closed 250 MHz up to 9×9, missed from 11×11.&lt;br&gt;• Every architecture needs N²·K DSPs (device: 220); only the tree can spill multipliers into LUTs.&lt;br&gt;• Limits 3 / 8 / 180 sit one step inside the measured boundaries (9×9, 220 DSPs) as margin.&lt;br&gt;&lt;br&gt;&lt;b&gt;Single-chain builds only:&lt;/b&gt; (* max_fanout = 24 *) on the pixel write-enable register&lt;br&gt;(~97 loads; rtl_3 WNS +0.386 → +0.757 ns, 5 register replicas)." style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1020" y="420" width="820" height="206" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page3" name="3 Line buffer"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="line_buffer — (N−1) row history in shift-register LUTs (example N = 3, W = 32)" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="34" as="geometry"/></mxCell><mxCell id="n3" value="The current row is not stored: it is passed straight through as o_rows[N−1]. All banks shift on i_write_en." style="text;html=1;align=left;verticalAlign=top;fontSize=14;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1600" height="24" as="geometry"/></mxCell><mxCell id="n4" value="i_write_en" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="150" height="40" as="geometry"/></mxCell><mxCell id="n5" value="i_pixel [7:0]" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="150" height="40" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;SRL bank 0 · srl_style = &quot;srl&quot; · W taps × 8 bit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;r_bank[0][0] → r_bank[0][1] → … → r_bank[0][W−1]  (1 row delay)&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="240" y="200" width="760" height="100" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;SRL bank 1 · W taps × 8 bit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;r_bank[1][0] → … → r_bank[1][W−1]  (2 rows delay)&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="240" y="380" width="760" height="100" as="geometry"/></mxCell><mxCell id="n8" value="o_rows[2] = live pixel (current row)" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1120" y="75" width="300" height="40" as="geometry"/></mxCell><mxCell id="n9" value="o_rows[1] = r_bank[0][W−1] (1 row old)" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1120" y="230" width="300" height="40" as="geometry"/></mxCell><mxCell id="n10" value="o_rows[0] = r_bank[1][W−1] (2 rows old)" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1120" y="410" width="300" height="40" as="geometry"/></mxCell><mxCell id="n11" value="8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n12" value="r_bank[0][W−1]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="250"/><mxPoint x="1040" y="340"/><mxPoint x="200" y="340"/><mxPoint x="200" y="430"/></Array></mxGeometry></mxCell><mxCell id="n13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n7" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n15" value="pass-through" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="250"/><mxPoint x="200" y="95"/></Array></mxGeometry></mxCell><mxCell id="n16" value="shift enable" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="130"/></Array></mxGeometry></mxCell><mxCell id="n17" value="&lt;b&gt;r_col_addr&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;⌈log₂W⌉ bits&lt;br&gt;+1 on i_write_en, wraps at W−1&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="240" y="560" width="280" height="110" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;w_row_done&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;i_write_en ∧ (r_col_addr == W−1)&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="580" y="570" width="280" height="90" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;r_rows_loaded&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;0 … N−1, +1 per row_done&lt;br&gt;saturates (sticky until rst_n)&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="920" y="560" width="280" height="110" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;o_rows_ready&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;r_rows_loaded == N−1&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1260" y="570" width="260" height="90" as="geometry"/></mxCell><mxCell id="n21" value="o_row_done → window_generator" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="580" y="720" width="280" height="40" as="geometry"/></mxCell><mxCell id="n22" value="o_rows_ready → window_generator" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1260" y="720" width="260" height="40" as="geometry"/></mxCell><mxCell id="n23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;exitX=0.9;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="n4" target="n17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="155" y="615"/></Array></mxGeometry></mxCell><mxCell id="n24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n17" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n18" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n19" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n18" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n20" target="n22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;Memory:&lt;/b&gt; (N−1) × W × 8 bits in SRLC32E primitives — 3×3/32: 16 SRL LUTs, 22 LUTs for the whole module.&lt;br&gt;&lt;b&gt;Alternatives measured:&lt;/b&gt; LUTRAM ring buffer (RAM32M, same-address read/write): −8 LUT at 3×3/32 and −96 LUT at 13×13/64,&lt;br&gt;but the column address toggles into every RAM LUT: +1.1–1.9 mW / +5.5 mW → FoM −0.3 … +0.3% / −0.5%, not adopted.&lt;br&gt;BRAM needs one (N−1)×8-bit word per column plus a look-ahead read address; it only pays off for rows of ~128–256 pixels.&lt;br&gt;&lt;b&gt;Frame protocol:&lt;/b&gt; r_rows_loaded is sticky, so each frame starts from rst_n." style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="800" width="1200" height="110" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;Colours&lt;/b&gt;&lt;br&gt;yellow: registers / counters&lt;br&gt;red: window cells · adders&lt;br&gt;blue: DSP48E1 · purple: memory&lt;br&gt;white: logic · dashed box: optional&lt;br&gt;bold red arrow: PCOUT → PCIN · dashed grey: valid / enable" style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1560" y="110" width="300" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page4" name="4 Window generator"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="window_generator — N × N window register (example N = 3)" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Every row of the window is a small shift register fed by one line-buffer tap; it shifts on each accepted pixel." style="text;html=1;align=left;verticalAlign=top;fontSize=14;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1600" height="24" as="geometry"/></mxCell><mxCell id="n4" value="i_rows[0] (2 rows old)" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="220" height="40" as="geometry"/></mxCell><mxCell id="n5" value="i_rows[1] (1 row old)" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="220" height="40" as="geometry"/></mxCell><mxCell id="n6" value="i_rows[2] (live)" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="220" height="40" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;r_window[0][0]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;8 bit&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="150" height="60" as="geometry"/></mxCell><mxCell id="n8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;r_window[0][1]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;8 bit&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="500" y="110" width="150" height="60" as="geometry"/></mxCell><mxCell id="n10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;r_window[0][2]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;8 bit&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="700" y="110" width="150" height="60" as="geometry"/></mxCell><mxCell id="n12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n9" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="o_window[0] … o_window[2]  (row 0, j = 0..2)" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="960" y="120" width="360" height="40" as="geometry"/></mxCell><mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n11" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;r_window[1][0]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;8 bit&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="240" width="150" height="60" as="geometry"/></mxCell><mxCell id="n16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;r_window[1][1]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;8 bit&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="500" y="240" width="150" height="60" as="geometry"/></mxCell><mxCell id="n18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n15" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;r_window[1][2]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;8 bit&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="700" y="240" width="150" height="60" as="geometry"/></mxCell><mxCell id="n20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n17" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="o_window[3] … o_window[5]  (row 1, j = 0..2)" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="960" y="250" width="360" height="40" as="geometry"/></mxCell><mxCell id="n22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n19" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;r_window[2][0]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;8 bit&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="370" width="150" height="60" as="geometry"/></mxCell><mxCell id="n24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;r_window[2][1]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;8 bit&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="500" y="370" width="150" height="60" as="geometry"/></mxCell><mxCell id="n26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n23" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;r_window[2][2]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;8 bit&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="700" y="370" width="150" height="60" as="geometry"/></mxCell><mxCell id="n28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n25" target="n27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n29" value="o_window[6] … o_window[8]  (row 2, j = 0..2)" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="960" y="380" width="360" height="40" as="geometry"/></mxCell><mxCell id="n30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n27" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n31" value="i_write_en" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="540" width="220" height="40" as="geometry"/></mxCell><mxCell id="n32" value="i_row_done" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="220" height="40" as="geometry"/></mxCell><mxCell id="n33" value="i_rows_ready" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="220" height="40" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b&gt;r_col_cnt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;reset on i_row_done&lt;br&gt;+1 on i_write_en until N&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="540" width="320" height="110" as="geometry"/></mxCell><mxCell id="n35" value="&lt;b&gt;o_valid (register)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;i_write_en: ← i_rows_ready ∧ (r_col_cnt ≥ N−1)&lt;br&gt;otherwise ← 0&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="700" y="540" width="360" height="110" as="geometry"/></mxCell><mxCell id="n36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="n31" target="n34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="n32" target="n34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n34" target="n35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="n33" target="n35"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="680"/></Array></mxGeometry></mxCell><mxCell id="n40" value="o_valid → operands valid" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1140" y="575" width="240" height="40" as="geometry"/></mxCell><mxCell id="n41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n35" target="n40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n42" value="&lt;b&gt;Tap order (the one non-obvious detail):&lt;/b&gt; a new column enters at j = 0, so the flattened window is row-ascending but column-descending:&lt;br&gt;&amp;nbsp;&amp;nbsp;o_window[i·N + j] = image[row + i][col + (N−1−j)]&lt;br&gt;Loading weights verbatim would compute a column-mirrored result; the host (conv_lab contract.pack_kernel) reverses each kernel row.&lt;br&gt;&lt;b&gt;Cost at 3×3:&lt;/b&gt; 72 window FFs + 3 counter/valid FFs, 1–2 LUTs. The window is valid for (W−N+1) columns of each row after N−1 rows are loaded." style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="1300" height="94" as="geometry"/></mxCell><mxCell id="n43" value="&lt;b&gt;Colours&lt;/b&gt;&lt;br&gt;yellow: registers / counters&lt;br&gt;red: window cells · adders&lt;br&gt;blue: DSP48E1 · purple: memory&lt;br&gt;white: logic · dashed box: optional&lt;br&gt;bold red arrow: PCOUT → PCIN · dashed grey: valid / enable" style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1560" y="110" width="300" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page5" name="5 Kernel register"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="kernel_register — programmable N² × 8-bit signed weights (one per kernel lane)" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Weights are streamed in on i_data with i_weight_valid and i_select_kernel = k, then held static for the frame." style="text;html=1;align=left;verticalAlign=top;fontSize=14;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1600" height="24" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Lane enable (conv_system)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;i_write_en = r_weight_write_en&lt;br&gt;∧ (i_select_kernel == k)&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="260" height="90" as="geometry"/></mxCell><mxCell id="n5" value="i_weight = r_data [7:0]" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="200" height="40" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;r_weights[E−1]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;8-bit signed&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="250" width="150" height="60" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;r_weights[E−2]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;8-bit signed&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="500" y="250" width="150" height="60" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;r_weights[E−3]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;8-bit signed&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="700" y="250" width="150" height="60" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;…&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="900" y="250" width="150" height="60" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;r_weights[0]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;8-bit signed&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1100" y="250" width="150" height="60" as="geometry"/></mxCell><mxCell id="n11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n12" value="shift" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="shift" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="shift" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n15" value="shift" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n16" value="o_weights[0 … E−1] — all E = N² taps in parallel to the MAC (static during the frame)" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="660" y="380" width="600" height="40" as="geometry"/></mxCell><mxCell id="n17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.86;entryY=0;" edge="1" parent="1" source="n10" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;r_loaded_cnt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;⌈log₂(E+1)⌉ bits&lt;br&gt;+1 per write until E; next write → 0&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="480" width="330" height="110" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;o_ready&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;r_loaded_cnt == E&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="700" y="490" width="250" height="90" as="geometry"/></mxCell><mxCell id="n20" value="o_ready → operands valid (AND over lanes)" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1010" y="515" width="340" height="40" as="geometry"/></mxCell><mxCell id="n21" value="shift enable" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="230"/><mxPoint x="375" y="230"/></Array></mxGeometry></mxCell><mxCell id="n22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="n4" target="n18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="535"/></Array></mxGeometry></mxCell><mxCell id="n23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n18" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n19" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;Load protocol:&lt;/b&gt; N² writes; the first weight written ends in r_weights[0] (kernel row-major order, rows reversed by the host).&lt;br&gt;A write after the register is full restarts the count: o_ready drops until N² new weights are loaded.&lt;br&gt;rst_n clears all weights and the counter. Shift-loading needs no write pointer or address decode: 5 LUTs at 3×3 (was 16 with indexed writes).&lt;br&gt;In DSP builds the weights are registered once more into each slice's B port (BREG); they need no skew because they are static." style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="1280" height="94" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;Colours&lt;/b&gt;&lt;br&gt;yellow: registers / counters&lt;br&gt;red: window cells · adders&lt;br&gt;blue: DSP48E1 · purple: memory&lt;br&gt;white: logic · dashed box: optional&lt;br&gt;bold red arrow: PCOUT → PCIN · dashed grey: valid / enable" style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1560" y="110" width="300" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page6" name="6 Single chain"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="mac_single_chain — all N² DSP48E1 slices in one PCOUT → PCIN chain (example N = 3)" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="34" as="geometry"/></mxCell><mxCell id="n3" value="acc[e] = acc[e−1] + pixel[e]·weight[e] on the DSP post-adder; no fabric adders (2 LUTs in the module)." style="text;html=1;align=left;verticalAlign=top;fontSize=14;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1600" height="24" as="geometry"/></mxCell><mxCell id="n4" value="o_window[0]" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="130" height="40" as="geometry"/></mxCell><mxCell id="n5" value="skew: 1 FF (AREG)" style="whiteSpace=wrap;html=1;fontSize=13;r