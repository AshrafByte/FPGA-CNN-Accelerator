gn=center;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3075" y="620" width="160" height="24" as="geometry"/></mxCell><mxCell id="ma224" value="" style="verticalLabelPosition=bottom;shadow=0;dashed=0;align=center;html=1;verticalAlign=top;shape=mxgraph.electrical.logic_gates.d_type_flip-flop;" vertex="1" parent="1"><mxGeometry x="3115" y="650" width="60" height="45" as="geometry"/></mxCell><mxCell id="ma225" value="ENABLE_RELU = 0:&lt;br&gt;a wire, 0 cycles" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="3045" y="720" width="210" height="60" as="geometry"/></mxCell><mxCell id="ma226" value="16 s" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.3617;exitDx=0;exitDy=0;exitPerimeter=0;" edge="1" parent="1" source="ma215" target="ma222"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ma227" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ma222" target="ma224"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ma228" value="output_fifo — DEPTH = (W−N)(N−1) = 58" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=15;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="3290" y="300" width="470" height="640" as="geometry"/></mxCell><mxCell id="ma229" value="&lt;b&gt;RAM 64 × 16 b&lt;/b&gt;&lt;br&gt;LUTRAM at 3×3 / 32&lt;br&gt;(BRAM chosen when&lt;br&gt;cheaper in FoM terms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;arcSize=10;" vertex="1" parent="1"><mxGeometry x="3320" y="370" width="200" height="160" as="geometry"/></mxCell><mxCell id="ma230" value="q_write_ptr +1 on i_valid" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="3550" y="370" width="190" height="44" as="geometry"/></mxCell><mxCell id="ma231" value="q_read_ptr +1 on read" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="3550" y="440" width="190" height="44" as="geometry"/></mxCell><mxCell id="ma232" value="q_prefilled" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3550" y="515" width="160" height="24" as="geometry"/></mxCell><mxCell id="ma233" value="" style="verticalLabelPosition=bottom;shadow=0;dashed=0;align=center;html=1;verticalAlign=top;shape=mxgraph.electrical.logic_gates.d_type_flip-flop;" vertex="1" parent="1"><mxGeometry x="3580" y="545" width="60" height="45" as="geometry"/></mxCell><mxCell id="ma234" value="" style="verticalLabelPosition=bottom;shadow=0;dashed=0;align=center;html=1;verticalAlign=top;shape=mxgraph.electrical.logic_gates.logic_gate;operation=and;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3570" y="640" width="70" height="50" as="geometry"/></mxCell><mxCell id="ma235" value="will_read" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="3560" y="692" width="150" height="24" as="geometry"/></mxCell><mxCell id="ma236" value="o_data" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3350" y="670" width="160" height="24" as="geometry"/></mxCell><mxCell id="ma237" value="" style="verticalLabelPosition=bottom;shadow=0;dashed=0;align=center;html=1;verticalAlign=top;shape=mxgraph.electrical.logic_gates.d_type_flip-flop;" vertex="1" parent="1"><mxGeometry x="3390" y="700" width="60" height="45" as="geometry"/></mxCell><mxCell id="ma238" value="o_valid" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3550" y="740" width="160" height="24" as="geometry"/></mxCell><mxCell id="ma239" value="" style="verticalLabelPosition=bottom;shadow=0;dashed=0;align=center;html=1;verticalAlign=top;shape=mxgraph.electrical.logic_gates.d_type_flip-flop;" vertex="1" parent="1"><mxGeometry x="3580" y="770" width="60" height="45" as="geometry"/></mxCell><mxCell id="ma240" value="prefill stores one frame's worth of row-edge gaps,&lt;br&gt;then o_valid stays high → 1 output pixel per cycle&lt;br&gt;37 LUT, 30 FF at 3×3 / 32" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="3320" y="850" width="420" height="70" as="geometry"/></mxCell><mxCell id="ma241" value="16 s" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.3617;exitDx=0;exitDy=0;exitPerimeter=0;" edge="1" parent="1" source="ma224" target="ma229"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3275" y="666"/><mxPoint x="3275" y="450"/></Array></mxGeometry></mxCell><mxCell id="ma242" value="wr addr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ma230" target="ma229"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3535" y="392"/><mxPoint x="3535" y="400"/></Array></mxGeometry></mxCell><mxCell id="ma243" value="rd addr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ma231" target="ma229"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3535" y="462"/><mxPoint x="3535" y="480"/></Array></mxGeometry></mxCell><mxCell id="ma244" value="≥ 57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#666666;fontSize=11;entryX=0;entryY=0.3617;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ma230" target="ma233"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3760" y="392"/><mxPoint x="3760" y="520"/><mxPoint x="3570" y="520"/><mxPoint x="3570" y="561"/></Array></mxGeometry></mxCell><mxCell id="ma245" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#666666;fontSize=11;exitX=1;exitY=0.3617;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="ma233" target="ma234"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3655" y="561"/><mxPoint x="3655" y="625"/><mxPoint x="3560" y="625"/><mxPoint x="3560" y="652"/></Array></mxGeometry></mxCell><mxCell id="ma246" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#666666;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.3617;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ma234" target="ma239"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3605" y="740"/><mxPoint x="3570" y="740"/><mxPoint x="3570" y="786"/></Array></mxGeometry></mxCell><mxCell id="ma247" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#666666;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="ma234" target="ma231"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3750" y="665"/><mxPoint x="3750" y="462"/></Array></mxGeometry></mxCell><mxCell id="ma248" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.3617;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ma229" target="ma237"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3420" y="600"/><mxPoint x="3370" y="600"/><mxPoint x="3370" y="716"/></Array></mxGeometry></mxCell><mxCell id="ma249" value="o_feature[k] [15:0]" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="3790" y="695" width="190" height="30" as="geometry"/></mxCell><mxCell id="ma250" value="o_valid (lane 0)" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="3790" y="765" width="190" height="30" as="geometry"/></mxCell><mxCell id="ma251" value="16 s" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.3617;exitDx=0;exitDy=0;exitPerimeter=0;" edge="1" parent="1" source="ma237" target="ma249"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3470" y="716"/><mxPoint x="3470" y="710"/></Array></mxGeometry></mxCell><mxCell id="ma252" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.3617;exitDx=0;exitDy=0;exitPerimeter=0;" edge="1" parent="1" source="ma239" target="ma250"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3700" y="786"/><mxPoint x="3700" y="780"/></Array></mxGeometry></mxCell><mxCell id="ma253" value="valid pipeline&lt;br&gt;(cycles added)" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1205" width="190" height="50" as="geometry"/></mxCell><mxCell id="ma254" value="input reg · +1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="240" y="1205" width="250" height="50" as="geometry"/></mxCell><mxCell id="ma255" value="SRL tap · +0 (the tap is registered in the SRL)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="520" y="1205" width="590" height="50" as="geometry"/></mxCell><mxCell id="ma256" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="ma254" target="ma255"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ma257" value="window o_valid · +1 · AND kernel ready" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1160" y="1205" width="520" height="50" as="geometry"/></mxCell><mxCell id="ma258" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="ma255" target="ma257"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ma259" value="MAC valid shift register · +11 single chain · +7 row chains · +7 tree" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1800" y="1205" width="780" height="50" as="geometry"/></mxCell><mxCell id="ma260" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="ma257" target="ma259"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ma261" value="r_valid_s1 → o_valid · +2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2680" y="1205" width="320" height="50" as="geometry"/></mxCell><mxCell id="ma262" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="ma259" target="ma261"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ma263" value="+1 or +0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="3030" y="1205" width="230" height="50" as="geometry"/></mxCell><mxCell id="ma264" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="ma261" target="ma263"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ma265" value="FIFO prefill, then +1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="3290" y="1205" width="470" height="50" as="geometry"/></mxCell><mxCell id="ma266" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="ma263" target="ma265"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ma267" value="Stalls on i_pixel_valid pause every counter; the valid bits keep feature order and count. One frame per reset: r_rows_loaded and q_prefilled are sticky. First output ≈ 2 rows + window/MAC/round delay + 58-entry prefill; sustained throughput 1 output pixel per cycle." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="240" y="1265" width="3400" height="26" as="geometry"/></mxCell><mxCell id="ma268" value="&lt;b&gt;Competition build — N = 3, W = 32, K = 1, no ReLU · xc7z020clg400-1 · Vivado 2018.2 · 4.000 ns (250 MHz)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• MAC_SEL = 3 (single chain) · output FIFO in LUTRAM&lt;br&gt;• 70 LUT · 474 FF · 9 DSP48E1 · 0 BRAM → LUT + 50·DSP + 100·BRAM = 520&lt;br&gt;• WNS +0.757 ns → Fmax ≈ 308 MHz&lt;br&gt;• Power 120.4 mW (bars + Sobel-X) / 111.1 mW (checkerboard + Sobel-Y)&lt;br&gt;• FoM 0.01597 / 0.01731 · throughput 1 output pixel per cycle&lt;br&gt;• Widths: pixel 8 u → operand 9 s · weight 8 s · product 16 s · sum 16 + ⌈log₂N²⌉ = 20 s · feature 16 s (DROP = 4)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;" vertex="1" parent="1"><mxGeometry x="240" y="1320" width="1760" height="210" as="geometry"/></mxCell><mxCell id="ma269" value="&lt;b&gt;MAC selection at elaboration (N = WINDOW_SIZE, K = NUM_KERNELS)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• K = 1: N ≤ 3 → single chain · 4 ≤ N ≤ 8 → row chains · N ≥ 9 → multiplier array + adder tree&lt;br&gt;• K ≥ 2: N ≤ 8 and N²·K ≤ 180 → row chains, otherwise multiplier array + adder tree (never the single chain)&lt;br&gt;• Why: single-chain skew FFs grow as N⁴ and the chain must fit one DSP column;&lt;br&gt;&amp;nbsp;&amp;nbsp;row chains missed 250 MHz from 11×11; only the tree can put multipliers in LUTs when DSPs run out&lt;br&gt;• Limits (3, 8, 180) sit one step inside the measured boundaries (9×9, 220 DSPs)&lt;br&gt;• Verified: Questa sweeps (stall on/off, all three MACs) + Python golden model, 53/53 hardware cases" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;" vertex="1" parent="1"><mxGeometry x="2040" y="1320" width="1720" height="210" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="blocks" name="1b Microarchitecture (Blocks)"><mxGraphModel dx="2000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2140" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="blk-1" value="&lt;b&gt;Microarchitecture — conv_system (block level)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="900" height="34" as="geometry"/></mxCell><mxCell id="blk-2" value="Streaming N×N convolution · the front end is shared; everything in the dashed box is one lane per kernel (× NUM_KERNELS)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1300" height="24" as="geometry"/></mxCell><mxCell id="blk-3" value="i_data [7:0]" style="text;html=1;align=right;verticalAlign=middle;fontSize=15;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="205" width="150" height="24" as="geometry"/></mxCell><mxCell id="blk-4" value="i_pixel_valid" style="text;html=1;align=right;verticalAlign=middle;fontSize=15;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="285" width="150" height="24" as="geometry"/></mxCell><mxCell id="blk-5" value="i_weight_valid" style="text;html=1;align=right;verticalAlign=middle;fontSize=15;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="505" width="150" height="24" as="geometry"/></mxCell><mxCell id="blk-6" value="i_select_kernel" style="text;html=1;align=right;verticalAlign=middle;fontSize=15;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="562.5" width="150" height="24" as="geometry"/></mxCell><mxCell id="blk-7" value="Input&lt;br&gt;Registers" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="200" width="150" height="400" as="geometry"/></mxCell><mxCell id="blk-8" value="Line Buffer&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:13px&quot;&gt;(N−1) rows&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="200" width="170" height="110" as="geometry"/></mxCell><mxCell id="blk-9" value="Window&lt;br&gt;Generator&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:13px&quot;&gt;N × N&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="670" y="200" width="170" height="110" as="geometry"/></mxCell><mxCell id="blk-10" value="Per-kernel lane  × NUM_KERNELS" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=15;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="890" y=