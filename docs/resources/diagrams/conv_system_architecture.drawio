<?xml version="1.0" ?><mxfile host="app.diagrams.net" version="24.0.0" type="device"><diagram id="page1" name="1 Microarchitecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3990" pageHeight="1560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ma2" value="Microarchitecture — conv_system (final design: one MAC architecture generated per kernel size N and kernel count K)" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2600" height="40" as="geometry"/></mxCell><mxCell id="ma3" value="Streaming N×N convolution, stride 1, valid-only output, drawn for the competition build N = 3, W = 32, K = 1: 8-bit unsigned pixels, 8-bit signed weights, 16-bit signed features." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="3400" height="24" as="geometry"/></mxCell><mxCell id="ma4" value="The front end (input registers, line buffer, window generator) is shared. The kernel register and everything from the MAC onward is one lane per kernel, replicated NUM_KERNELS times." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="3400" height="24" as="geometry"/></mxCell><mxCell id="ma5" value="Yellow/red: registers · blue: DSP48E1 · purple: memory · bold red arrows: dedicated PCOUT → PCIN cascade · dashed grey arrows: valid / enable." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="116" width="3400" height="24" as="geometry"/></mxCell><mxCell id="ma6" value="① INPUT" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="240" y="160" width="250" height="28" as="geometry"/></mxCell><mxCell id="ma7" val