# =============================================================================
# Default wave.do for dut_uvm_tb - generated by generate_uvm_env.py.
#
# This is a REAL, hand-editable file, not a hidden default - edit freely.
# It's read by run.do's own wave.do check, so once this exists, run.do's
# blanket "log -r /$TOP/*" fallback no longer applies to this module -
# RECORD is honored here instead.
#
# WARNING: `make uvm_tb IP=name --overwrite` deletes and regenerates the
# entire sim/ folder, INCLUDING any edits made to this file. If you've
# curated this list, back it up (or move it out of the generated tree)
# before regenerating.
# =============================================================================

# The generator template instantiates the device under test under this
# name. Kept as one variable rather than repeated inline, and kept in
# sync with the actual testbench automatically: this whole file goes
# through the same target-renaming pass as every other template file, so
# as long as the testbench's own instantiation ALSO uses "dut_instance"
# literally, both get renamed identically at generation time - no
# separate detection/substitution logic needed.
set INSTANCE_NAME dut_instance

if {$RECORD} {
    # Full-hierarchy record so anything can still be added later via
    # `make wave`, even if it's not covered by the line below.
    log -r /$TOP/*
}

view wave

# The instance's own ports/top-level signals (not recursive into its own
# sub-instances, to keep the default view from getting noisy) - add -r
# below if internal hierarchy should also be visible by default.
add wave -noupdate /$TOP/$INSTANCE_NAME/*
