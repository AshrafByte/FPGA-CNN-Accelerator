ll><mxCell id="n72" value="A 9s" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n68" target="n69"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n73" value="B 8s" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n70" target="n69"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n74" value="PCOUT→PCIN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontColor=#b85450;" edge="1" parent="1" source="n61" target="n69"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n75" value="o_sum = P of DSP #8 (ACCUM_WIDTH = 20)" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="470" y="1060" width="330" height="40" as="geometry"/></mxCell><mxCell id="n76" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n69" target="n75"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n77" value="&lt;b&gt;Valid pipeline&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;r_valid[0 … LATENCY−1]&lt;br&gt;LATENCY = 2 + N² (11 cycles at 3×3)&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1100" y="100" width="360" height="90" as="geometry"/></mxCell><mxCell id="n78" value="&lt;b&gt;Why the skew registers&lt;/b&gt;&lt;br&gt;Slice e runs e cycles after slice 0 (the partial sum moves one PREG per cycle).&lt;br&gt;The window presents all N² taps on the same cycle, so tap e is delayed e+1 cycles&lt;br&gt;(input register + e skew stages) to multiply values from one window.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cost&lt;/b&gt;&lt;br&gt;skew FF = 9·Σ(e+1) = 9·N²(N²+1)/2 (N⁴ growth); srl_style = &quot;register&quot; keeps them out of SRL LUTs.&lt;br&gt;3×3: 226 FF, 2 LUT, 9 DSP in the module → 70 LUT for the whole design.&lt;br&gt;&lt;br&gt;&lt;b&gt;Limits&lt;/b&gt;&lt;br&gt;• the whole chain must fit one DSP column (xc7z020 columns: 20/20/60/60/60)&lt;br&gt;• 9×9: WNS −1.38 ns; 13×13: 115k FF, does not fit → used only for N ≤ 3, K = 1&lt;br&gt;&lt;br&gt;&lt;b&gt;Rounding&lt;/b&gt;&lt;br&gt;ROUND_BIAS could add 2^(DROP−1) through slice 0's C port (rtl_la_opt did);&lt;br&gt;conv_system leaves it at 0 and keeps rounding in round_saturate.&lt;br&gt;&lt;br&gt;&lt;b&gt;Timing&lt;/b&gt;&lt;br&gt;every register-to-register path is skew FF → A port, or inside/between DSPs." style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1100" y="230" width="760" height="334" as="geometry"/></mxCell><mxCell id="n79" value="&lt;b&gt;Colours&lt;/b&gt;&lt;br&gt;yellow: registers / counters&lt;br&gt;red: window cells · adders&lt;br&gt;blue: DSP48E1 · purple: memory&lt;br&gt;white: logic · dashed box: optional&lt;br&gt;bold red arrow: PCOUT → PCIN · dashed grey: valid / enable" style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1560" y="760" width="300" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page7" name="7 Row chains"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="mac_row_chain — one DSP chain per window row + short fabric tree (example N = 3)" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Row r: sum_r = Σ_j pixel(r, j)·weight(r, j) through PCOUT → PCIN; the N row sums are reduced by a bit-growing adder tree." style="text;html=1;align=left;verticalAlign=top;fontSize=14;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1600" height="24" as="geometry"/></mxCell><mxCell id="n4" value="Row chain 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=15;spacingLeft=10;spacingTop=4;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="1120" height="240" as="geometry"/></mxCell><mxCell id="n5" value="tap (0,0)" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="125" width="140" height="36" as="geometry"/></mxCell><mxCell id="n6" value="skew: 1 FF" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="50" y="180" width="140" height="36" as="geometry"/></mxCell><mxCell id="n7" value="w[0] → B" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="220" y="180" width="120" height="36" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;DSP (0,0)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;M = A·B (MREG) · P = M (PREG)&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="50" y="240" width="290" height="70" as="geometry"/></mxCell><mxCell id="n9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundCo