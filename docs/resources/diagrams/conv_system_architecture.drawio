</mxCell><mxCell id="n67" value="&lt;b&gt;Latency&lt;/b&gt;&lt;br&gt;3 (multiplier_array)&lt;br&gt;+ ⌈log₂N²⌉ (adder_tree)&lt;br&gt;= 7 cycles at 3×3&lt;br&gt;&lt;br&gt;&lt;b&gt;Cost at 3×3&lt;/b&gt;&lt;br&gt;adder_tree 139 LUT / 190 FF&lt;br&gt;whole design 205 LUT, 429 FF" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1600" y="90" width="290" height="158" as="geometry"/></mxCell><mxCell id="n68" value="&lt;b&gt;Used for&lt;/b&gt; N ≥ 9 with one kernel, and when N &gt; 8 or N²·K &gt; 180 with several kernels — the only architecture whose multipliers can move into LUTs when the DSPs run out (17×17 → 200 DSP + fabric multipliers with -max_dsp). At 3×3 it has the best Fmax of the three (~308 MHz) but the most LUTs (FoM 0.01226 / 0.01227)." style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="960" width="1500" height="62" as="geometry"/></mxCell><mxCell id="n69" value="&lt;b&gt;Colours&lt;/b&gt;&lt;br&gt;yellow: registers / counters&lt;br&gt;red: window cells · adders&lt;br&gt;blue: DSP48E1 · purple: memory&lt;br&gt;white: logic · dashed box: optional&lt;br&gt;bold red arrow: PCOUT → PCIN · dashed grey: valid / enable" style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1580" y="700" width="300" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page9" name="9 Round &amp; saturate"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="round_saturate — ACCUM_WIDTH → 16 bits, round half up, clamp only when reachable (example N = 3: 20 → 16, DROP = 4)" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Two register stages. Parameters IN_WIDTH, OUT_WIDTH and IN_MAX = N²·255·127 (passed from conv_system as ACCUM_MAX)." style="text;html=1;align=left;verticalAlign=top;fontSize=14;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1600" height="24" as="geometry"/></mxCell><mxCell id="n4" value="i_data [19:0]" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="170" height="40" as="geometry"/></mxCell><mxCell id="n5" value="i_valid" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="170" height="40" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Split&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;trunc = i_data[19:4] (16 bit)&lt;br&gt;guard = i_data[3]&lt;br&gt;(first dropped bit)&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="250" y="130" width="230" height="140" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Overflow flag (NEED_SAT)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;(trunc == 0x7FFF) ∧ guard&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;dashed=1;" vertex="1" parent="1"><mxGeometry x="250" y="330" width="230" height="100" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Stage A (CE i_valid)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;r_trunc_val [15:0]&lt;br&gt;r_guard_bit&lt;br&gt;r_overflow&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="560" y="130" width="220" height="300" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Round half up&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;r_trunc_val + r_guard_bit&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;ellipse;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="860" y="170" width="190" height="90" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Clamp mux (NEED_SAT)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;r_overflow ? 0x7FFF : rounded&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;dashed=1;" vertex="1" parent="1"><mxGeometry x="1110" y="160" width="220" height="110" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;o_data [15:0]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;CE r_valid_s1&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1400" y="160" width="200" height="110" as="geometry"/></mxCell><mxCell id="n12" value="o_data [15:0]" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1660" y="195" width="170" height="40" as="geometry"/></mxCell><mxCell id="n13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="r_valid_s1" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="560" y="550" width="200" height="60" as="geometry"/></mxCell><mxCell id="n15" value="o_valid" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="860" y="550" width="200" height="60" as="geometry"/></mxCell><mxCell id="n16" value="o_valid" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1660" y="560" width="170" height="40" as="geometry"/></mxCell><mxCell id="n17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="CE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="n5" target="n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="580"/><mxPoint x="210" y="460"/><mxPoint x="670" y="460"/></Array></mxGeometry></mxCell><mxCell id="n28" value="CE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="n14" target="n11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="500"/><mxPoint x="1500" y="500"/></Array></mxGeometry></mxCell><mxCell id="n29" value="&lt;b&gt;Round half up&lt;/b&gt; = floor((x + 2^(DROP−1)) / 2^DROP): keep the truncated value and add the first dropped bit. Ties go toward +∞ (4.5 → 5, −4.5 → −4).&lt;br&gt;&lt;b&gt;When can it overflow?&lt;/b&gt; Truncation never overflows; rounding can only exceed the top code by +1, for x ≥ 2^(IN−1) − 2^(DROP−1). Negative values never overflow.&lt;br&gt;&lt;b&gt;NEED_SAT&lt;/b&gt; is decided at elaboration: ROUNDED_MAX = (IN_MAX + 2^(DROP−1)) &gt;&gt; DROP. With 8-bit data the largest window sum is N²·255·127&lt;br&gt;(3×3: 291 465 → 18 217 &lt; 32 767), so for every N the clamp is unreachable and &lt;b&gt;no overflow or clamp logic is built&lt;/b&gt; (dashed blocks).&lt;br&gt;&lt;b&gt;DROP = 0&lt;/b&gt; (small N): gen_passthrough registers a sign-extended copy instead.&lt;br&gt;&lt;b&gt;Golden model:&lt;/b&gt; sw/conv_lab/core/reference.py uses the same rule; the regression checks every ±0.5 tie." style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="670" width="1400" height="126" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;Colours&lt;/b&gt;&lt;br&gt;yellow: registers / counters&lt;br&gt;red: window cells · adders&lt;br&gt;blue: DSP48E1 · purple: memory&lt;br&gt;white: logic · dashed box: optional&lt;br&gt;bold red arrow: PCOUT → PCIN · dashed grey: valid / enable" style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1560" y="700" width="300" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page10" name="10 ReLU"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="relu_unit — optional activation after round_saturate (bonus feature)" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Built per lane only when ENABLE_RELU = 1; otherwise conv_system connects round_saturate straight to the output FIFO." style="text;html=1;align=left;verticalAlign=top;fontSize=14;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1600" height="24" as="geometry"/></mxCell><mxCell id="n4" value="i_feature [15:0]" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="160" width="180" height="40" as="geometry"/></mxCell><mxCell id="n5" value="i_valid" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="360" width="180" height="40" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Sign bit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;i_feature[15]&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="270" y="120" width="200" height="70" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Clamp&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;sign ? 0 : i_feature&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="540" y="140" width="220" height="90" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;o_feature [15:0]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;CE i_valid&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="830" y="140" width="200" height="90" as="geometry"/></mxCell><mxCell id="n9" value="o_valid" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="830" y="340" width="200" height="80" as="geometry"/></mxCell><mxCell id="n10" value="o_feature" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1100" y="165" width="170" height="40" as="geometry"/></mxCell><mxCell id="n11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n12" value="o_valid" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1100" y="360" width="170" height="40" as="geometry"/></mxCell><mxCell id="n13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n9" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="235" y="240"/><mxPoint x="520" y="240"/><mxPoint x="520" y="200"/></Array></mxGeometry></mxCell><mxCell id="n16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="CE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="n5" target="n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="380"/></Array></mxGeometry></mxCell><mxCell id="n20" value="&lt;b&gt;Latency&lt;/b&gt; 1 cycle (0 when bypassed); feature order, count and valid pattern are unchanged.&lt;br&gt;&lt;b&gt;Placement&lt;/b&gt; after round_saturate is exact: round_saturate is monotonic and maps 0 to 0, so relu(rs(x)) = rs(relu(x)), and the&lt;br&gt;sign decision is made on 16 instead of 20 bits.&lt;br&gt;&lt;b&gt;Verified&lt;/b&gt; by conv_system_tb (ENABLE_RELU = 1 configurations). The Python image regression drives the raw features (ReLU off)." style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="1250" height="94" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page11" name="11 Output FIFO"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="output_fifo — prefill buffer that turns the gapped MAC stream into one output per cycle" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Power-of-two RAM with self-wrapping pointers; LUTRAM or BRAM chosen at elaboration (FIFO_RAM_MODE 0 = auto, 1 = LUTRAM, 2 = BRAM)." style="text;html=1;align=left;verticalAlign=top;fontSize=14;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1600" height="24" as="geometry"/></mxCell><mxCell id="n4" value="i_valid" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="150" height="40" as="geometry"/></mxCell><mxCell id="n5" value="i_data [15:0]" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="150" height="40" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;q_write_ptr&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;ADDR_WIDTH = ⌈log₂(DEPTH+1)⌉&lt;br&gt;+1 on i_valid&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="240" y="110" width="260" height="90" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;RAM: RAM_DEPTH × 16 bit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;RAM_DEPTH = 2^ADDR_WIDTH (3×3/32: 64)&lt;br&gt;write r_mem[q_write_ptr] on i_valid&lt;br&gt;&lt;br&gt;LUTRAM: async read → o_data register&lt;br&gt;BRAM (USE_BRAM): synchronous read register&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="590" y="150" width="320" height="220" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;q_read_ptr&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;+1 on w_will_read&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="240" y="420" width="260" height="90" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;q_prefilled&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;set when q_write_ptr ≥ PREFILL_THRESHOLD−1&lt;br&gt;sticky until rst_n&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="230" y="570" width="330" height="110" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;w_will_read&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;q_prefilled ∧ (q_read_ptr ≠ q_write_ptr)&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="590" y="460" width="320" height="90" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;o_data [15:0]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;CE w_will_read&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1000" y="190" width="220" height="90" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;o_valid&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;← w_will_read&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1000" y="460" width="220" height="90" as="geometry"/></mxCell><mxCell id="n13" value="o_feature[k]" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1300" y="215" width="190" height="40" as="geometry"/></mxCell><mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n11" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n15" value="o_valid" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1300" y="485" width="190" height="40" as="geometry"/></mxCell><mxCell id="n16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n12" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="16s" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="write address" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n20" value="read address" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n8" target="n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="565" y="465"/><mxPoint x="565" y="330"/></Array></mxGeometry></mxCell><mxCell id="n21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="n6" target="n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="155"/><mxPoint x="210" y="625"/></Array></mxGeometry></mxCell><mxCell id="n22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="155"/><mxPoint x="520" y="505"/></Array></mxGeometry></mxCell><mxCell id="n25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n7" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n10" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="370" y="541"/></Array></mxGeometry></mxCell><mxCell id="n28" value="&lt;b&gt;Why a FIFO&lt;/b&gt;: the MAC output is invalid for N−1 cycles at every row edge. DEPTH = PREFILL_THRESHOLD = (W−N)(N−1) stores one frame's worth of those gaps&lt;br&gt;before reading starts, so o_valid then stays high: &lt;b&gt;one output pixel per cycle&lt;/b&gt; (measured 900 features in 900 consecutive cycles at 3×3/32).&lt;br&gt;3×3/32: DEPTH 58 → RAM 64 × 16 in LUTRAM (24 RAM + 13 logic LUT).&lt;br&gt;&lt;b&gt;Automatic memory choice&lt;/b&gt;: BRAM only if its LUTs + tile cost (RAMB18 = 0.5, RAMB36 = 1 × 100 points) + its power converted to resource points&lt;br&gt;is below the LUTRAM LUT count. Verified in Vivado: LUTRAM at 3×3/32 and 13×13/32; BRAM at 5×5/64 (+4.2% FoM), 7×7/64 (+7.3%), 13×13/64 (+4.4%).&lt;br&gt;&lt;b&gt;Frame protocol&lt;/b&gt;: q_prefilled is sticky — reset between frames." style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="720" width="1500" height="126" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;Colours&lt;/b&gt;&lt;br&gt;yellow: registers / counters&lt;br&gt;red: window cells · adders&lt;br&gt;blue: DSP48E1 · purple: memory&lt;br&gt;white: logic · dashed box: optional&lt;br&gt;bold red arrow: PCOUT → PCIN · dashed grey: valid / enable" style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1560" y="110" width="300" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page12" name="12 Control &amp; latency"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Control — a valid-driven pipeline (no state register) and its latency" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Every stage forwards a valid bit alongside its data; the implicit states below are decoded from counters that already exist." style="text;html=1;align=left;verticalAlign=top;fontSize=14;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1600" height="24" as="geometry"/></mxCell><mxCell id="n4" value="i_pixel_valid" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="150" height="50" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Input reg&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;1 cycle&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="210" y="110" width="150" height="110" as="geometry"/></mxCell><mxCell id="n6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;line_buffer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;0 (SRL tap)&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="400" y="110" width="150" height="110" as="geometry"/></mxCell><mxCell id="n8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;window_generator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;1 cycle&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="590" y="110" width="150" height="110" as="geometry"/></mxCell><mxCell id="n10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;∧ kernel ready&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;0&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="780" y="110" width="150" height="110" as="geometry"/></mxCell><mxCell id="n12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n9" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;MAC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;tree 3 + ⌈log₂N²⌉&lt;br&gt;rows 2 + N + ⌈log₂N⌉&lt;br&gt;chain 2 + N²&lt;br&gt;3×3: 7 / 7 / 11&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="970" y="110" width="210" height="110" as="geometry"/></mxCell><mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n11" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;round_saturate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;2 cycles&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1220" y="110" width="150" height="110" as="geometry"/></mxCell><mxCell id="n16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n13" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;relu_unit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;0 or 1&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;dashed=1;" vertex="1" parent="1"><mxGeometry x="1410" y="110" width="150" height="110" as="geometry"/></mxCell><mxCell id="n18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n15" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;output_fifo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;prefill, then 1&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1600" y="110" width="150" height="110" as="geometry"/></mxCell><mxCell id="n20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n17" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="o_valid" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1790" y="110" width="150" height="50" as="geometry"/></mxCell><mxCell id="n22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n19" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;RESET&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;rst_n low: all counters, pointers and flags cleared&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="430" height="110" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;LOAD KERNEL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;r_loaded_cnt &lt; N² → o_ready = 0; weights shift in&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="500" y="330" width="430" height="110" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;FILL LINES&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;r_rows_loaded &lt; N−1 → no window valid yet&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="960" y="330" width="430" height="110" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;FILL WINDOW&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;r_col_cnt &lt; N−1 at the start of each row&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1420" y="330" width="430" height="110" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;STREAM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;window valid each accepted pixel → MAC → round → ReLU → FIFO&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="430" height="110" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b&gt;PREFILL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;q_prefilled = 0 → FIFO stores, no output&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="500" y="530" width="430" height="110" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;OUTPUT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;q_prefilled = 1 → o_valid every cycle while data is buffered&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="960" y="530" width="430" height="110" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;DRAIN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;i_pixel_valid low → pipeline and FIFO empty, o_valid returns low&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1420" y="530" width="430" height="110" as="geometry"/></mxCell><mxCell id="n31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n23" target="n24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n24" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n25" target="n26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n26" target="n27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1635" y="470"/><mxPoint x="255" y="470"/></Array></mxGeometry></mxCell><mxCell id="n35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n27" target="n28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n28" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n29" target="n30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n38" value="next row" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n27" target="n26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="384" y="500"/><mxPoint x="1880" y="500"/><mxPoint x="1880" y="385"/></Array></mxGeometry></mxCell><mxCell id="n39" value="next frame: rst_n" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n30" target="n23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1635" y="760"/><mxPoint x="20" y="760"/><mxPoint x="20" y="385"/></Array></mxGeometry></mxCell><mxCell id="n40" value="&lt;b&gt;No FSM register&lt;/b&gt;: the phases above are what the counters already encode — kernel_register.r_loaded_cnt, line_buffer.r_col_addr / r_rows_loaded,&lt;br&gt;window_generator.r_col_cnt, output_fifo.q_write_ptr / q_read_ptr / q_prefilled — plus one valid shift register per stage. Stalls on i_pixel_valid simply pause every counter.&lt;br&gt;&lt;b&gt;One frame per reset&lt;/b&gt;: r_rows_loaded and q_prefilled are sticky, so a second frame without rst_n would form cross-frame windows and lose the FIFO margin.&lt;br&gt;&lt;b&gt;Latency and throughput&lt;/b&gt;: first output after ≈ 2 rows + the window/MAC/round delay + the FIFO prefill; measured 142 cycles on rtl_la_opt (same streaming path).&lt;br&gt;Sustained throughput 1.000 output pixel per cycle; frame average 900 / 1024 = 0.879 at 3×3/32." style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="1780" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page13" name="13 Verification"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Verification — SystemVerilog self-checking testbench and a Python golden model driving the RTL in QuestaSim" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Both paths build the same hw/system/conv_system/sim/compile.f file list." style="text;html=1;align=left;verticalAlign=top;fontSize=14;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1600" height="24" as="geometry"/></mxCell><mxCell id="n4" value="SystemVerilog (hw/)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=15;spacingLeft=10;spacingTop=4;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="620" height="560" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;conv_system_tb.sv (self-checking)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;built-in model: MAC → round (ROUND_MODE 1 = half up) → clamp → ReLU&lt;br&gt;7 tests per configuration (identity, laplacian, negatives, extremes, …)&lt;br&gt;parameters: WINDOW_SIZE, INPUT_SIZE, NUM_KERNELS, ENABLE_RELU, STALL&lt;br&gt;STALL = 1: random 1–3 cycle (and 20-cycle) gaps on i_pixel_valid&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="50" y="140" width="560" height="180" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;DUT: conv_system&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;all three MAC architectures&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="50" y="380" width="260" height="90" as="geometry"/></mxCell><mxCell id="n7" value="stimulus / expected" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Unit testbenches&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;line_buffer_tb, output_fifo_tb&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="340" y="380" width="270" height="90" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Results&lt;/b&gt;&lt;br&gt;rtl_top_1: 40 configs (stall off/on) + one full run per architecture&lt;br&gt;rtl_2: 168/168 · rtl_3: 40/40 · rtl: 84/84 + 40/40 stall&lt;br&gt;experiments/*: 2 configs each + unit tbs — all pass" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="50" y="500" width="560" height="94" as="geometry"/></mxCell><mxCell id="n10" value="Python golden model (sw/conv_lab) + conv_image_tb" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=15;spacingLeft=10;spacingTop=4;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="680" y="90" width="1240" height="820" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;core/images.py, kernels.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;patterns, photos, 12 presets&lt;br&gt;random kernels&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="710" y="140" width="250" height="90" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;core/reference.py (golden)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;valid correlate&lt;br&gt;→ round half up (DROP)&lt;br&gt;→ 16-bit saturate&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="710" y="300" width="250" height="130" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;hardware/contract.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;write_stimulus, pack_kernel&lt;br&gt;(reverses kernel rows)&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1020" y="140" width="260" height="90" as="geometry"/></mxCell><mxCell id="n14" value="stimulus.txt&lt;br&gt;geometry, weights, pixels" style="whiteSpace=wrap;html=1;fontSize=13;shape=note;size=14;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1330" y="140" width="210" height="80" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;hardware/questa.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;vlog -F compile.f&lt;br&gt;vsim conv_image_tb -gINPUT_SIZE -gWINDOW_SIZE&lt;br&gt;-gNUM_KERNELS +stim +result&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1580" y="140" width="300" height="110" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;conv_image_tb → conv_system&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;streams one frame, records features&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1580" y="320" width="300" height="90" as="geometry"/></mxCell><mxCell id="n17" value="features.txt&lt;br&gt;OUTPUT_SIZE K DROP + values" style="whiteSpace=wrap;html=1;fontSize=13;shape=note;size=14;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1330" y="320" width="210" height="80" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;contract.parse_results&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;(K, N−N_k+1, …) int32&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1020" y="320" width="260" height="90" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;harness.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;reference vs hardware&lt;br&gt;DROP check, per-lane compare&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1020" y="490" width="260" height="110" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;core/comparison.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;bit-exact verdict per kernel&lt;br&gt;PNG grid, failure lines&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="710" y="490" width="250" height="110" as="geometry"/></mxCell><mxCell id="n21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n11" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n17" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n18" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n29" value="golden frames" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n12" target="n19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="985" y="365"/><mxPoint x="985" y="545"/></Array></mxGeometry></mxCell><mxCell id="n30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n19" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b&gt;tests/unit (pytest -m &quot;not hardware&quot;)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;87 pass — model, ties (±0.5), 2^20 rounding sweep, contract, CLI&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="710" y="680" width="560" height="90" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b&gt;tests/regression (pytest -m hardware)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;53 pass in 11 min — every preset × pattern, frame sizes 4–64,&lt;br&gt;tap positions, extremes, rounding ties, 1–16 kernels, 5×5/7×7, 20 random&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1320" y="680" width="560" height="110" as="geometry"/></mxCell><mxCell id="n33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="n20" target="n31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="n19" target="n32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="650"/><mxPoint x="1600" y="650"/></Array></mxGeometry></mxCell><mxCell id="n35" value="CLI: python -m conv_lab --image photo.jpg --kernel sobel_x --png out.png runs a real image through the RTL and the model (edge-detection demo)." style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="710" y="820" width="1170" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page14" name="14 Results &amp; FoM"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="FPGA results and Figure of Merit (xc7z020clg400-1, Vivado 2018.2, 4.000 ns / 250 MHz)" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="34" as="geometry"/></mxCell><mxCell id="n3" value="FoM = Throughput / (Power × (LUTs + 50·DSPs + 100·BRAMs)); throughput = 1 output pixel per cycle; power from SAIF on the routed checkpoint." style="text;html=1;align=left;verticalAlign=top;fontSize=14;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1600" height="24" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Architecture comparison at the competition point&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border=&quot;1&quot; style=&quot;border-collapse:collapse;font-size:12px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#F5F5F5;padding:3px 6px&quot;&gt;3×3, 32×32, K = 1, no ReLU&lt;/th&gt;&lt;th style=&quot;background:#F5F5F5;padding:3px 6px&quot;&gt;tree (conv_tree)&lt;/th&gt;&lt;th style=&quot;background:#F5F5F5;padding:3px 6px&quot;&gt;row chains (conv_row_chain)&lt;/th&gt;&lt;th style=&quot;background:#F5F5F5;padding:3px 6px&quot;&gt;single chain, no fanout limit&lt;/th&gt;&lt;th style=&quot;background:#F5F5F5;padding:3px 6px&quot;&gt;&lt;b&gt;rtl_top_1 (single chain + max_fanout)&lt;/b&gt;&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;LUT / FF&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;205 / 429&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;110 / 322&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;70 / 469&lt;/td&gt;&lt;td style=&quot;background:#fff2cc;padding:3px 6px&quot;&gt;&lt;b&gt;70 / 474&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;DSP / BRAM&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;9 / 0&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;9 / 0&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;9 / 0&lt;/td&gt;&lt;td style=&quot;background:#fff2cc;padding:3px 6px&quot;&gt;&lt;b&gt;9 / 0&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;LUT + 50·DSP + 100·BRAM&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;655&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;560&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;520&lt;/td&gt;&lt;td style=&quot;background:#fff2cc;padding:3px 6px&quot;&gt;&lt;b&gt;520&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;WNS / Fmax&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;+0.751 ns / 307.8 MHz&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;+0.543 ns / 289.3 MHz&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;+0.386 ns / 276.7 MHz&lt;/td&gt;&lt;td style=&quot;background:#fff2cc;padding:3px 6px&quot;&gt;&lt;b&gt;+0.757 ns / 308.4 MHz&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Power, bars + Sobel-X&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;124.574 mW&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;120.391 mW&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;120.386 mW&lt;/td&gt;&lt;td style=&quot;background:#fff2cc;padding:3px 6px&quot;&gt;&lt;b&gt;120.408 mW&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;FoM, bars + Sobel-X&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;0.01226&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;0.01483&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;0.01597&lt;/td&gt;&lt;td style=&quot;background:#fff2cc;padding:3px 6px&quot;&gt;&lt;b&gt;0.01597&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Power, checker + Sobel-Y&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;124.408 mW&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;110.781 mW&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;111.070 mW&lt;/td&gt;&lt;td style=&quot;background:#fff2cc;padding:3px 6px&quot;&gt;&lt;b&gt;111.103 mW&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;FoM, checker + Sobel-Y&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;0.01227&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;0.01612&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;0.01731&lt;/td&gt;&lt;td style=&quot;background:#fff2cc;padding:3px 6px&quot;&gt;&lt;b&gt;0.01731&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;SAIF nets matched&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;21%&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;7%&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;6%&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;6%&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="1300" height="290" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Row-chain bit growth&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border=&quot;1&quot; style=&quot;border-collapse:collapse;font-size:12px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#F5F5F5;padding:3px 6px&quot;&gt;7×7, 32×32, K = 1 (row chains)&lt;/th&gt;&lt;th style=&quot;background:#F5F5F5;padding:3px 6px&quot;&gt;full-width tree&lt;/th&gt;&lt;th style=&quot;background:#F5F5F5;padding:3px 6px&quot;&gt;bit-growing tree&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;LUT total / in mac_row_chain&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;419 / 218&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;&lt;b&gt;405 / 204&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;FF total / in mac_row_chain&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;1379 / 487&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;&lt;b&gt;1368 / 476&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;DSP / BRAM&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;49 / 0&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;49 / 0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;WNS&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;+0.199 ns&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;+0.236 ns&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;Power (random SAIF)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;0.185 W&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;0.182 W&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="410" width="760" height="210" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Kernel-size scaling (earlier sweeps, WNS in ns)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border=&quot;1&quot; style=&quot;border-collapse:collapse;font-size:12px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#F5F5F5;padding:3px 6px&quot;&gt;N (1 kernel, 250 MHz)&lt;/th&gt;&lt;th style=&quot;background:#F5F5F5;padding:3px 6px&quot;&gt;single chain&lt;/th&gt;&lt;th style=&quot;background:#F5F5F5;padding:3px 6px&quot;&gt;row chains&lt;/th&gt;&lt;th style=&quot;background:#F5F5F5;padding:3px 6px&quot;&gt;tree&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;479 FF, +0.63&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;335 FF, +0.49&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;442 FF, +0.63&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;5&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;2742 FF, +0.11&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;803 FF, +0.28&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;993 FF, +0.51&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;7&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;9971 FF, +0.20&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;1398 FF, +0.20&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;1799 FF, +0.37&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;9&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;26775 FF, −1.38&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;2256 FF, +0.15&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;2913 FF, +0.26&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;11&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;59325 FF, −1.56&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;3299 FF, −0.04&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;4271 FF, +0.30&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;13&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;NOFIT&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;4482 FF, −0.28&lt;/td&gt;&lt;td style=&quot;padding:3px 6px&quot;&gt;5953 FF, +0.14&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="820" y="410" width="700" height="230" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Power notes&lt;/b&gt;: static floor ≈ 0.105 W (73% is the idle Zynq PS + XADC, identical for every PYNQ-Z2 design). Chain designs match only 6–7% of nets to the SAIF&lt;br&gt;(registers absorbed into DSPs lose their RTL names), so part of their lower dynamic power is Vivado's propagated estimate; LUT counts are exact.&lt;br&gt;&lt;b&gt;Critical paths&lt;/b&gt;: 3×3 single chain — weight write enable → LUT2 → CE of 76 weight FFs (+0.757 ns); row chains 7×7 — pixel write-enable fanout (+0.236 ns);&lt;br&gt;tree / rows at 3×3 — output_fifo read pointer → LUT6 → LUT3 → o_data CE." style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="670" width="1500" height="94" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>